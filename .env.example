APP_NAME="Sai Consulting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://saiconsultingchanasma.in
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Kolkata

ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_MOBILE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APPOINTMENT_ADMIN_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CUSTOMER_NOTIFICATION_QUEUE=customer-notifications
CUSTOMER_NOTIFICATION_RETENTION_DAYS=365

# MSG91 WhatsApp remains disabled until production credentials and approved
# template-language flags are configured manually in the hosting environment.
MSG91_WHATSAPP_ENABLED=false
MSG91_WHATSAPP_AUTHKEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_ENDPOINT=https://control.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
MSG91_WHATSAPP_TIMEOUT=10
MSG91_WHATSAPP_DEFAULT_LANGUAGE=gu
MSG91_WHATSAPP_TEMPLATE_REQUEST_RECEIVED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_REQUEST_RECEIVED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_REQUEST_ACCEPTED_PAYMENT_PENDING_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_REQUEST_ACCEPTED_PAYMENT_PENDING_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_PAYMENT_RECEIVED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_PAYMENT_RECEIVED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_REQUEST_REJECTED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_REQUEST_REJECTED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_WORK_COMPLETED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_WORK_COMPLETED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_DOCUMENT_READY_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_DOCUMENT_READY_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_DISPATCH_NOTIFICATION_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_DISPATCH_NOTIFICATION_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_NOTIFICATION_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_NOTIFICATION_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_CERTIFIED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_CERTIFIED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_REJECTED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_ENTRY_REJECTED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED_EN_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED_GU_ENABLED=false
MSG91_WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED_EN_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Production must use APP_ENV=production, APP_DEBUG=false, the final HTTPS
# APP_URL, SESSION_SECURE_COOKIE=true, LOG_LEVEL=warning, a real SMTP mailer,
# and MySQL/Redis/database credentials supplied only by the hosting environment.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
